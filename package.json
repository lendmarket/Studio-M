{
  "name": "studio-m",
  "productName": "Studio M",
  "version": "0.3.1",
  "description": "Studio M - 영상 편집기",
  "author": "lendmarket",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "release": "npm run build && electron-builder --win --x64 --publish always",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
